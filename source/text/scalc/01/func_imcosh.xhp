<body>
<bookmark branch="hid/SC_HID_AAI_FUNC_IMCOSH" id="bm_id123221232212322" localize="false"/>
<bookmark branch="index" id="bm_id123771237712377">
<bookmark_value>IMCOSH function</bookmark_value>
<bookmark_value>hyperbolic cosine;complex number</bookmark_value>
</bookmark>
<section id="func_imcosh_function">
<h1 id="hd_id124691246912469"><variable id="imcosh_head"><link href="text/scalc/01/func_imcosh.xhp">IMCOSH</link></variable> function</h1>
<description id="par_id125881258812588"><variable id="imcosh_des">Returns the hyperbolic cosine of a complex number.</variable></description>
</section>
<paragraph role="paragraph" id="par_id171785954431880">The hyperbolic cosine of a complex number can be expressed by its real and imaginary parts:</paragraph>
	<embed href="text/scalc/06/mathmlfunc.xhp#imcosh"/>
	<embed href="text/scalc/01/ful_func.xhp#func_im_des"/>
    <embed href="text/scalc/00/avail_release.xhp#3.6"/>
	<embed href="text/scalc/01/ful_func.xhp#func_head_syntax"/>
	<paragraph id="par_id16051131322110" role="code">
		IMCOSH(Complex_number)
	</paragraph>
	<paragraph id="par_id766137661376613" role="paragraph">
	<emph>Complex_number</emph> is a complex number whose hyperbolic cosine is to be calculated.
	</paragraph>
	<note localize="false" id="par_id193292656220842">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_comp_numb"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_real_numb"/>
	</note>
	<warning localize="false" id="par_id24300832426190">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_return_text"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_ignor_zero"/>
	</warning>
	<embed href="text/scalc/01/ful_func.xhp#func_head_example"/>
	<paragraph id="par_id55891471962" role="paragraph">
		<item type="input">=IMCOSH("4-3i")</item><br/>
		returns -27.0349456030742-3.85115333481178i.
	</paragraph>
	<paragraph id="par_id152561887112896" role="paragraph">
		<item type="input">=IMCOSH(2)</item><br/>
		returns 3.76219569108363 as a string. <embedvar href="text/scalc/01/ful_func.xhp#func_imag_zero"/>
	</paragraph>
        <embed href="text/scalc/06/calcsamplefiles.xhp#imtrigon"/>
	<embed href="text/scalc/01/common_func.xhp#sectiontechinfo"/>
	<embed href="text/scalc/01/ODFF.xhp#odff"/>

	<section id="relatedtopics">
		<tip id="par_id331677015717191"><link href="https://wiki.documentfoundation.org/Documentation/Calc_Functions/IMCOSH">IMCOSH wiki page</link>.</tip>
