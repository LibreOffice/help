<body>
<bookmark id="bm_id581792606491124" branch="hid/.uno:FitCellSize" localize="false"/>
<bookmark branch="index" id="bm_id641792606545434">
    <bookmark_value>object;fit to cell size</bookmark_value>
    <bookmark_value>object size;fit to cell size</bookmark_value>
    <bookmark_value>image size;fit to cell size</bookmark_value>
</bookmark>
<section id="fit2cellsize">
    <h1 id="hd_id441792606491125"><variable id="h1"><link href="text/scalc/01/fit_to_cell_size.xhp">Fit to Cell Size</link></variable></h1>
    <description id="par_id91792606491125">Resizes the image to the size of the cell.</description>
</section>
<section id="howtoget">
    <embed href="text/shared/00/00000004.xhp#from_menu_bar"/>
    <paragraph role="paragraph" id="par_id741792607206844">Choose <menuitem>Format - Image - Fit to Cell Size</menuitem>.</paragraph>
    <embed href="text/shared/00/00000004.xhp#from_context"/>
    <paragraph role="paragraph" id="par_id921692906925993">Choose <menuitem>Fit to Cell Size</menuitem>.</paragraph>
</section>
<note id="par_id891792621435511">The image must be anchored as <link href="text/shared/01/fit_to_cell.xhp">To Cell (resize with cell)</link>.</note>

<section id="relatedtopics">
    <paragraph role="paragraph" id="par_id561792622564936" localize="false"><embedvar href="text/shared/01/fit_to_cell.xhp#h1" markup="ignore"/> </paragraph>
</section>
