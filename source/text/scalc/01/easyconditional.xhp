<body>
<bookmark id="bm_id231785970559262" branch="hid/modules/scalc/ui/conditionaleasydialog/" localize="false"/>

<bookmark branch="index" id="bm_id171785972644299">
    <bookmark_value>conditional format;easy</bookmark_value>
    <bookmark_value>easy conditional format</bookmark_value>
    <bookmark_value>easy conditional format;greater than</bookmark_value>
    <bookmark_value>easy conditional format;less than</bookmark_value>
    <bookmark_value>easy conditional format;between than</bookmark_value>
    <bookmark_value>easy conditional format;equal than</bookmark_value>
    <bookmark_value>easy conditional format;containing text</bookmark_value>
</bookmark>
<section id="easycondformat">
    <h1 id="hd_id671785970559262"><variable id="h1"><link href="text/scalc/01/easyconditional.xhp">Easy Conditional Format</link></variable></h1>
    <description id="par_id31785970559262">Provides easier ways for cell and ranges conditional formatting.</description>
</section>
<section id="howtoget">
    <embed href="text/shared/00/00000004.xhp#from_menu_bar"/>
    <paragraph role="paragraph" id="par_id841785971934510">Choose <menuitem>Format - Conditional - Conditions</menuitem> and select <menuitem>Greater than</menuitem>, <menuitem>Less than</menuitem>, <menuitem>Equals</menuitem>, <menuitem>Between</menuitem>, <menuitem>Containing text</menuitem> and <menuitem>More Rules</menuitem>.</paragraph>
    <embed href="text/shared/00/00000004.xhp#from_tabUI"/>
    <paragraph role="paragraph" id="par_id261785971940820">On the <menuitem>Home</menuitem> tab, choose <menuitem>Conditional - Conditions</menuitem> and select <menuitem>Greater than</menuitem>, <menuitem>Less than</menuitem>, <menuitem>Equals</menuitem>, <menuitem>Between</menuitem>, <menuitem>Containing text</menuitem> and <menuitem>More Rules</menuitem>.</paragraph>
</section>
<h2 id="hd_id441785971644601">Greater than, Less than, Equals, Between, Containing text</h2>
<paragraph role="paragraph" id="par_id731785972740182">Select the condition to apply to the cell or cell range.</paragraph>
<bookmark branch="hid/modules/scalc/ui/conditionaleasydialog/entryNumber" id="bm_id371785973460085" localize="false"/>
<bookmark branch="hid/modules/scalc/ui/conditionaleasydialog/entryNumber2" id="bm_id3717854573460085" localize="false"/>
<h3 id="hd_id891785971370733">Highlight cells with values</h3>
<paragraph role="paragraph" id="par_id411785971376766">Enter the first value of the range or the text for comparison and formatting. For the "Between" condition, specify the interval limits.</paragraph>
<bookmark branch="hid/modules/scalc/ui/conditionaleasydialog/themeCombo" id="bm_id741785973487369" localize="false"/>
<h3 id="hd_id521785971382079">Apply cell style</h3>
<paragraph role="paragraph" id="par_id631785971386781">Cell style to apply when conditions are met.</paragraph>
<bookmark branch="hid/modules/scalc/ui/conditionaleasydialog/entryRange" id="bm_id631785973716778" localize="false"/>
<h3 id="hd_id351785971393331">Range</h3>
<paragraph role="paragraph" id="par_id581785971402069">Range of cells for conditional formatting.</paragraph>
</body>
