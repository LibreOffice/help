    <bookmark branch="hid/modules/scalc/ui/sidebaralignment/@@nowidget@@" id="bm_id831732201958209" localize="false"/>
    <section id="alignment">
        <h1 id="hd_id251732200613060"><variable id="h1"><link href="text/scalc/01/sidebar_alignment.xhp">Alignment</link></variable></h1>
        <section id="alignment_content">
            <paragraph role="paragraph" id="par_id771732200675151">Use the <menuitem>Alignment</menuitem> panel in the <menuitem>Properties</menuitem> sidebar deck to set alignment options for the contents of the current cell, or the selected cells.</paragraph>
        </section>
    </section>
    <section id="howtoget">
        <embed href="text/shared/00/00000004.xhp#from_keyboard"/>
        <paragraph role="paragraph" id="par_id951731685437740"><switchinline select="sys"><caseinline select="MAC"><keycode>Option</keycode></caseinline><defaultinline><keycode>Alt</keycode></defaultinline></switchinline><keycode> + 1</keycode></paragraph>
        <embed href="text/shared/00/00000004.xhp#from_sidebar"/>
        <paragraph role="paragraph" id="par_id831731684980486">Open the <menuitem>Properties</menuitem> sidebar panel and expand the <menuitem>Alignment</menuitem> deck.</paragraph>
        <embed href="text/shared/01/sidebar_properties.xhp#sysidebar_properties"/>
    </section>
