<body>
<bookmark branch="hid/SC_HID_AAI_FUNC_IMSIN" id="bm_id146733115823392" localize="false"/>
<bookmark branch="index" id="bm_id79322063230162">
<bookmark_value>IMSIN function</bookmark_value>
<bookmark_value>sine;complex number</bookmark_value>
</bookmark>
<section id="imsin_function">
<h1 id="hd_id3192388765304"><variable id="imsin_head"><link href="text/scalc/01/func_imsin.xhp">IMSIN</link></variable> function</h1>
<description id="par_id1955633330277"><variable id="imsin_des">Returns the sine of a complex number. </variable></description>
</section>
<paragraph role="paragraph" id="par_id631785954256270">The sine of a complex number can be expressed by its real and imaginary parts:</paragraph>
	<embed href="text/scalc/06/mathmlfunc.xhp#imsin"/>
	<embed href="text/scalc/01/ful_func.xhp#func_im_des"/>
	<embed href="text/scalc/01/ful_func.xhp#func_head_syntax"/>
	<paragraph id="par_id284611113926520" role="code">
		IMSIN(Complex_number)
	</paragraph>
	<paragraph id="par_id31206835928272" role="paragraph">
	<emph>Complex_number</emph> is a complex number whose sine needs to be calculated.
	</paragraph>
	<note localize="false" id="par_id100182106819457">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_comp_numb"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_real_numb"/>
	</note>
	<warning localize="false" id="par_id7175173509788">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_return_text"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_ignor_zero"/>
	</warning>
	<embed href="text/scalc/01/ful_func.xhp#func_head_example"/>
	<paragraph id="par_id5063188419467" role="paragraph">
		<item type="input">=IMSIN("4-3i")</item><br/>
		returns -7.61923172032141+6.548120040911i.
	</paragraph>
	<paragraph id="par_id1527387141125" role="paragraph">
		<item type="input">=IMSIN(2)</item><br/>
		returns 0.909297426825682 as a string. <embedvar href="text/scalc/01/ful_func.xhp#func_imag_zero"/>
	</paragraph>
        <embed href="text/scalc/06/calcsamplefiles.xhp#imtrigon"/>
	<embed href="text/scalc/01/common_func.xhp#sectiontechinfo"/>
	<embed href="text/scalc/01/ODFF.xhp#odff"/>
	<section id="relatedtopics">
		<tip id="par_id331677015597133"><link href="https://wiki.documentfoundation.org/Documentation/Calc_Functions/IMSIN">IMSIN wiki page</link>.</tip>
		<paragraph id="par_id2773214341302" role="paragraph" localize="false">
			<embedvar href="text/scalc/01/func_imsinh.xhp#imsinh_head"/>,
			<embedvar href="text/scalc/01/func_imcos.xhp#imcos_head"/>,
			<embedvar href="text/scalc/01/func_imcosh.xhp#imcosh_head"/>
		</paragraph>
	</section>
