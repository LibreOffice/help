<bookmark id="bm_id91783686031327" branch="hid/SC_HID_FUNC_IS_OMITTED_MS" localize="false"/>
<bookmark branch="index" id="bm_id1001783687799995">
<bookmark_value>ISOMITTED function</bookmark_value>
</bookmark>

<section id="isomitted">
    <h1 id="hd_id241783686031327"><variable id="h1"><link href="text/scalc/01/func_isomitted.xhp">ISOMITTED Function</link></variable></h1>
    <description id="par_id281783686031328">Returns whether a LAMBDA parameter was provided (FALSE) or omitted (TRUE). Only valid within a LAMBDA expression.</description>
</section>
<embed href="text/scalc/01/ful_func.xhp#func_head_syntax"/>
<paragraph role="code" id="par_id801783687174304">=ISOMITTED(Name)</paragraph>
<paragraph role="paragraph" id="par_id721783687428293"><emph>Name</emph>: The name of the parameter to check.</paragraph>

