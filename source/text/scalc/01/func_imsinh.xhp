<body>
<section id="imsech_function">
<bookmark branch="hid/SC_HID_AAI_FUNC_IMSINH" id="bm_id146733115823392" localize="false"/>
<bookmark branch="index" id="bm_id79322063230162">
<bookmark_value>IMSINH function</bookmark_value>
<bookmark_value>hyperbolic sine;complex number</bookmark_value>
</bookmark>
<h1 id="hd_id3192388765304"><variable id="imsinh_head"><link href="text/scalc/01/func_imsinh.xhp">IMSINH</link></variable> function</h1>
<description id="par_id1955633330277"><variable id="imsinh_des">Returns the hyperbolic sine of a complex number.</variable></description>
</section>
<paragraph role="paragraph" id="par_id771785955070282">The hyperbolic sine of a complex number can be expressed by its real and imaginary parts:</paragraph>
	<embed href="text/scalc/06/mathmlfunc.xhp#imsinh"/>
	<embed href="text/scalc/01/ful_func.xhp#func_im_des"/>
        <embed href="text/scalc/00/avail_release.xhp#3.6"/>
	<embed href="text/scalc/01/ful_func.xhp#func_head_syntax"/>
	<paragraph id="par_id284611113926520" role="code">
		IMSINH(Complex_number)
	</paragraph>
	<paragraph id="par_id31206835928272" role="paragraph">
	<emph>Complex_number</emph> is a complex number whose hyperbolic sine needs to be calculated.
	</paragraph>
	<note localize="false" id="par_id100182106819457">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_comp_numb"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_real_numb"/>
	</note>
	<warning localize="false" id="par_id7175173509788">
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_return_text"/><br/>
		<embedvar href="text/scalc/01/ful_func.xhp#func_im_ignor_zero"/>
	</warning>
	<embed href="text/scalc/01/ful_func.xhp#func_head_example"/>
	<paragraph id="par_id5063188419467" role="paragraph">
		<item type="input">=IMSINH("4-3i")</item><br/>
		returns -27.0168132580039-3.85373803791938i.
	</paragraph>
	<paragraph id="par_id1527387141125" role="paragraph">
		<item type="input">=IMSINH(2)</item><br/>
		returns 3.62686040784702 as a string. <embedvar href="text/scalc/01/ful_func.xhp#func_imag_zero"/>
	</paragraph>
        <embed href="text/scalc/06/calcsamplefiles.xhp#imtrigon"/>
	<embed href="text/scalc/01/common_func.xhp#sectiontechinfo"/>
	<embed href="text/scalc/01/ODFF.xhp#odff"/>
	<section id="relatedtopics">
		<tip id="par_id121677015577147"><link href="https://wiki.documentfoundation.org/Documentation/Calc_Functions/IMSINH">IMSINH wiki page</link>.</tip>
