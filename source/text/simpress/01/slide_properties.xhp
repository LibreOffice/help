    <embed href="text/shared/01/05210100.xhp#area"/>
    <tip id="par_id3145587">To change the background of all of the slides in the active file, select a background, click <emph>OK</emph> and click <emph>Yes</emph> in the <emph>Page Setup</emph> dialog.</tip>
