    <section id="slideproperties">
      <h1 id="hd_id3149379"><variable id="h1"><link href="text/simpress/01/slide_properties.xhp#slideproperties">Slide Properties</link></variable></h1>
      <description id="par_id3150717"><variable id="seiteeintext"><ahelp hid=".uno:SlideSetup" visibility="visible">Sets slide orientation, slide margins, background and other layout options.</ahelp></variable></description>
    </section>
    <section id="howtoget">
