    <meta>
        <topic id="text/shared/01/original_size.xhp" indexer="include" status="PUBLISH">
            <title id="tit">Original Size</title>
            <filename>/text/shared/01/original_size.xhp</filename>
        </topic>
    </meta>
    <body>
    <bookmark id="bm_id921792613007345" branch="hid/.uno:OriginalSize" localize="false"/>

    <section id="originalsize">
        <h1 id="hd_id901792613007345"><variable id="h1"><link href="text/shared/01/original_size.xhp">Original Size</link></variable></h1>
        <description id="par_id761792613007345">Reset the size settings of the selected object to the original values.</description>
    </section>
    <section id="howtoget">
        <embed href="text/shared/00/00000004.xhp#from_menu_bar"/>
        <switch select="appl">
            <case select="WRITER">
                <paragraph role="paragraph" id="par_id71792618316365">Choose <menuitem>Format - Image - Position and Size - Original Size</menuitem>.</paragraph>
                <paragraph role="paragraph" id="par_id811792618321806">Choose <menuitem>Format - Image - Crop - Original Size</menuitem>.</paragraph>
            </case>
            <default>
                <paragraph role="paragraph" id="par_id91792613139432">Choose <menuitem>Format - Image - Original Size</menuitem>.</paragraph>
            </default>
        </switch>
        <embed href="text/shared/00/00000004.xhp#from_context"/>
        <switch select="appl">
            <case select="WRITER"></case>
            <default>
                <paragraph role="paragraph" id="par_id331792616665224">Choose <menuitem>Original Size</menuitem>.</paragraph>
            </default>
        </switch>
        <embed href="text/shared/00/00000004.xhp#from_tabUI"/>
        <paragraph role="paragraph" id="par_id731792616765629">On the <menuitem>Image</menuitem> menu of the <menuitem>Image</menuitem> tab, choose <menuitem>Original Size</menuitem>.</paragraph>
    </section>
    <section id="relatedtopics">
    </section>
    </body>
</helpdocument>
