<section id="pageproperties">
    <h1 id="hd_id501793536957115"><variable id="h1"><link href="text/sdraw/01/page_properties.xhp">Page Properties</link></variable></h1>
    <description id="par_id691793536957115">Sets page orientation, page margins, background and other layout options.</description>
